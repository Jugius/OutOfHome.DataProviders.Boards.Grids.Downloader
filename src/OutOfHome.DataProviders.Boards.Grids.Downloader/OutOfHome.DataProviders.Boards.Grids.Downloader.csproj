<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<LangVersion>default</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <RootNamespace>OutOfHome.DataProviders.Boards.Grids.Downloader</RootNamespace>
    <AssemblyName>OohelpSoft.OutOfHome.DataProviders.Boards.Grids.Downloader</AssemblyName>
	<PackageProjectUrl>https://github.com/Jugius/OutOfHome.DataProviders.Boards.Grids.Downloader</PackageProjectUrl>

	<Version>3.0.1</Version>
	<Authors>Andrey Slusarev</Authors>
	<Company>OoHelp.Net</Company>
	<PackageId>OohelpSoft.OutOfHome.DataProviders.Boards.Grids.Downloader</PackageId>
	<Copyright>©2026 Andrey Slusarev (OoHelp.Net)</Copyright>
	<Description>Библиотека загрузки сеток занятости основных OOH операторов (Украина)</Description>
	<PackageLicenseExpression>MIT</PackageLicenseExpression>	  
	<RepositoryType>git</RepositoryType>
	<RepositoryUrl>git://github.com/Jugius/OutOfHome.DataProviders.Boards.Grids.Downloader</RepositoryUrl>
	<PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\GlobalSuppressions.cs" Link="GlobalSuppressions.cs" />
  </ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Grids.Downloader.Tests" />
	</ItemGroup>

  <ItemGroup>
    <PackageReference Include="PuppeteerSharp" Version="25.5.0" PrivateAssets="Compile" />
  </ItemGroup>

</Project>
